rules_version = '2';

// Data model: users/{uid} stores uid, fullName, email, createdAt, updatedAt.
// businesses/{businessId} stores name, category, description, location, currency, timestamps.
// expenses/{expenseId} stores immutable businessId/source, transaction details, integer amountCents, timestamps.
// sales/{saleId} stores immutable businessId/source, description, integer amountCents, transaction date, payment details, timestamps.
// businesses/{businessId}/aiBriefings/{briefingId} stores server-generated analysis and narrative.
// AI briefings are read-only to clients; all other document validators below apply on create and update.

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsDocument(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validProfile(userId) {
      return request.resource.data.keys().hasOnly(['uid', 'fullName', 'email', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'fullName', 'email', 'createdAt', 'updatedAt'])
        && request.resource.data.uid is string
        && request.resource.data.uid == userId
        && request.resource.data.fullName is string
        && request.resource.data.fullName.trim().size() >= 2
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if ownsDocument(userId);
      allow list, delete: if false;
      allow create: if ownsDocument(userId)
        && validProfile(userId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if ownsDocument(userId)
        && validProfile(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'updatedAt'])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{userId}/businesses/{businessId} {
      allow get, list: if ownsDocument(userId);
      allow delete: if false;
      allow create: if ownsDocument(userId)
        && validBusiness()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if ownsDocument(userId)
        && validBusiness()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'category', 'description', 'location', 'updatedAt'])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    // AI briefings are written only by the authenticated Vercel backend via Admin SDK.
    // Clients may read their own saved reports while the parent business still exists.
    match /users/{userId}/businesses/{businessId}/aiBriefings/{briefingId} {
      allow get, list: if ownsDocument(userId)
        && exists(/databases/$(database)/documents/users/$(userId)/businesses/$(businessId));
      allow create, update, delete: if false;
    }

    function validBusiness() {
      return request.resource.data.keys().hasOnly(['name', 'category', 'description', 'location', 'currency', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['name', 'category', 'description', 'location', 'currency', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.trim().size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.category in ['Food & Beverage', 'Retail', 'Online Business', 'Services', 'Agriculture', 'Other']
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 120
        && request.resource.data.currency == 'MYR'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId}/expenses/{expenseId} {
      allow get, list: if ownsDocument(userId);
      allow create: if ownsDocument(userId)
        && validExpense()
        && exists(/databases/$(database)/documents/users/$(userId)/businesses/$(request.resource.data.businessId))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if ownsDocument(userId)
        && validExpense()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description', 'category', 'amountCents', 'transactionDate', 'paymentMethod', 'merchant', 'notes', 'updatedAt'])
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.source == resource.data.source
        && request.resource.data.createdAt == resource.data.createdAt
        && exists(/databases/$(database)/documents/users/$(userId)/businesses/$(resource.data.businessId))
        && request.resource.data.updatedAt == request.time;
      allow delete: if ownsDocument(userId)
        && exists(/databases/$(database)/documents/users/$(userId)/businesses/$(resource.data.businessId));
    }

    match /users/{userId}/sales/{saleId} {
      allow get, list: if ownsDocument(userId);
      allow create: if ownsDocument(userId)
        && validSale()
        && exists(/databases/$(database)/documents/users/$(userId)/businesses/$(request.resource.data.businessId))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if ownsDocument(userId)
        && validSale()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description', 'amountCents', 'transactionDate', 'paymentMethod', 'customer', 'notes', 'updatedAt'])
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.source == resource.data.source
        && request.resource.data.createdAt == resource.data.createdAt
        && exists(/databases/$(database)/documents/users/$(userId)/businesses/$(resource.data.businessId))
        && request.resource.data.updatedAt == request.time;
      allow delete: if ownsDocument(userId)
        && exists(/databases/$(database)/documents/users/$(userId)/businesses/$(resource.data.businessId));
    }

    function validTransactionDate(dateText) {
      let year = int(dateText[0:4]);
      let month = int(dateText[5:7]);
      let day = int(dateText[8:10]);
      return dateText.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && year >= 1 && year <= 9999
        && month >= 1 && month <= 12
        && day >= 1 && day <= 31
        && timestamp.date(year, month, day).year() == year
        && timestamp.date(year, month, day).month() == month
        && timestamp.date(year, month, day).day() == day;
    }

    function validExpense() {
      return request.resource.data.keys().hasOnly(['businessId', 'description', 'category', 'amountCents', 'transactionDate', 'paymentMethod', 'merchant', 'notes', 'source', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['businessId', 'description', 'category', 'amountCents', 'transactionDate', 'paymentMethod', 'merchant', 'notes', 'source', 'createdAt', 'updatedAt'])
        && request.resource.data.businessId is string
        && request.resource.data.businessId.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.data.description is string
        && request.resource.data.description.trim().size() >= 1
        && request.resource.data.description.size() <= 120
        && request.resource.data.category in ['Ingredients', 'Packaging', 'Utilities', 'Rent', 'Transportation', 'Equipment', 'Marketing', 'Other']
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents > 0
        && request.resource.data.amountCents <= 99999999999
        && request.resource.data.transactionDate is string
        && validTransactionDate(request.resource.data.transactionDate)
        && request.resource.data.paymentMethod in ['', 'Cash', 'Bank Transfer', 'E-Wallet', 'Debit/Credit Card', 'Other']
        && request.resource.data.merchant is string
        && request.resource.data.merchant.size() <= 120
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.source == 'manual'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validSale() {
      return request.resource.data.keys().hasOnly(['businessId', 'description', 'amountCents', 'transactionDate', 'paymentMethod', 'customer', 'notes', 'source', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['businessId', 'description', 'amountCents', 'transactionDate', 'paymentMethod', 'customer', 'notes', 'source', 'createdAt', 'updatedAt'])
        && request.resource.data.businessId is string
        && request.resource.data.businessId.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.data.description is string
        && request.resource.data.description.trim().size() >= 1
        && request.resource.data.description.size() <= 120
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents > 0
        && request.resource.data.amountCents <= 99999999999
        && request.resource.data.transactionDate is string
        && validTransactionDate(request.resource.data.transactionDate)
        && request.resource.data.paymentMethod in ['', 'Cash', 'Bank Transfer', 'E-Wallet', 'Debit/Credit Card', 'Other']
        && request.resource.data.customer is string
        && request.resource.data.customer.size() <= 120
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.source == 'manual'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }
  }
}
