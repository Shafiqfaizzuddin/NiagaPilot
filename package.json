    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "firebase-admin": {
      "jwks-rsa": "3.2.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
